<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="NEOCIO-Commons-Feed" value="https://neocioweb.pkgs.visualstudio.com/_packaging/NEOCIO-Commons-Feed/nuget/v3/index.json" />	
	</packageSources>

	<packageSourceMapping>
		<!-- Map most packages to nuget.org -->
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>

		<!-- Map NEOCIO packages to your internal feed -->
		<packageSource key="NEOCIO-Commons-Feed">
			<package pattern="NEOCIO.*" />
		</packageSource>
	</packageSourceMapping>
</configuration>