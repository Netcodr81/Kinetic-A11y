@page "/"
@using Kinetic_A11y.Web2.Components.Common.StylizedHeader
@using Kinetic_A11y.Web2.Web.Components.Common.StylizedHeader
@using Kinetic

@inject IDbContextFactory<DiscoveryDbContext> DbFactory
@inject DiscoveryQueue Queue
@inject NavigationManager Navigation

<PageTitle>Kinetic - a11y Website Discovery</PageTitle>
<div class="p-8">
    <StylizedHeader HeaderLevel="HeaderLevel.H1" HeaderText="Kinetic - A11y Website Discovery"/>
    <p class="text-sm">Enter a public website root URL to discover publicly linked PDF documents.</p>

    <div class="mt-4">
        <div class="form-group">
            <label class="form-label" for="rootUrl">Root website URL</label>
            <input class="form-control w-50" id="rootUrl" @bind="rootUrl" placeholder="https://www.example.gov"/>
        </div>
        <div class="form-group">
            <label class="form-label" for="depth">Max crawl depth</label>
            <input class="form-control w-50" id="depth" type="number" @bind="maxDepth" min="0" max="20"/>
        </div>

        <div class="form-group">
            <label class="form-label" for="pages">Max pages</label>
            <input class="form-control w-50" id="pages" type="number" @bind="maxPages" min="1" max="100000"/>
        </div>

        <div class="form-group">
            <BbFormFieldCheckbox
                InputClass="bg-white data-[state=checked]:bg-ocio-blue-500"
                Label="Scan accessibility and Best Practices (axe-core, WCAG A/AA/AAA)"
                @bind-Checked="scanAccessibility"/>
        </div>

        <div class="form-group">
            <BbFormFieldCheckbox InputClass="bg-white data-[state=checked]:bg-ocio-blue-500"
                Label="JavaScript-rendered scan (slower)"
                                 @bind-Checked="renderJavaScript"/>
            @if (renderJavaScript)
            {
                <label class="form-label mt-4" for="jsWait">Wait after page load (seconds)</label>
                <input class="form-control mb-2 w-50" id="jsWait" type="number" @bind="javaScriptWaitSeconds" min="0" max="60"/>
                <p class="text-sm">Chromium renders every page and waits before discovering links and checking accessibility, SEO, and broken links. Increase the wait for slow-loading content. This does not click buttons or guarantee that all background activity has finished.</p>
            }

        </div>


        <button class="btn btn-primary mt-3 mb-6" @onclick="StartAsync" disabled="@starting">@(starting ? "Starting..." : "Start discovery")</button>
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <p class="error">@error</p>
        }
    </div>

    <StylizedHeader HeaderLevel="HeaderLevel.H2" HeaderText="Recent Discovery Runs"/>
    <div class="discovery-table">
    <BbDataTable TData="DiscoveryRun" Data="runs" SelectionMode="DataTableSelectionMode.Multiple" ShowToolbar="false" 
                 InitialPageSize="25" PageSizes="[25, 50, 100]">
        <Columns>
            <BbDataTableColumn TData="DiscoveryRun" TValue="string" Property="@(t => t.RootUrl)" Header="Website" Sortable="true"/>

            <BbDataTableColumn TData="DiscoveryRun" TValue="DiscoveryRunStatus" Property="@(t => t.Status)" Header="Status" Sortable="true" />

            <BbDataTableColumn TData="DiscoveryRun" TValue="int" Property="@(t => t.PagesCrawled)" Header="Pages" Sortable="true">
                <CellTemplate Context="run">
                    <span>@run.PagesCrawled / @run.PagesDiscovered</span>
                </CellTemplate>
            </BbDataTableColumn>

            <BbDataTableColumn TData="DiscoveryRun" TValue="int" Property="@(t => t.PdfsDiscovered)" Header="PDFs" Sortable="true">
                <CellTemplate Context="run">
                    <span>@run.PdfsDiscovered (@run.PdfsValidated valid)</span>
                </CellTemplate>
            </BbDataTableColumn>

            <BbDataTableColumn TData="DiscoveryRun" TValue="Guid" Property="@(t => t.Id)" Header="A11y Score" Sortable="true">
                <CellTemplate Context="run">
                    @if (!run.ScanAccessibility)
                    {
                        <span>Off</span>
                    }
                    else
                    {
                        var score = run.AverageAccessibilityScore is { } avg ? (int?)Math.Round(avg) : null;
                        <span class="score score-@AccessibilityScoring.Band(score)">@(score?.ToString() ?? "—")</span>
                        @if (!qualitySummaries.ContainsKey(run.Id))
                        {
                            <span class="muted">Legacy</span>
                        }
                    }
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="DiscoveryRun" TValue="Guid" Property="@(t => t.Id)" Header="Site Score" Sortable="true">
                <CellTemplate Context="run">
                    @(qualitySummaries.TryGetValue(run.Id, out var summary) ? summary.Overall?.ToString("0.#") ?? "N/A" : "N/A")
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="DiscoveryRun" TValue="DateTimeOffset" Property="@(t => t.CreatedAt)" Header="Created" Sortable="true">
                <CellTemplate Context="run">
                    @run.CreatedAt.ToLocalTime().ToString("g")
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="DiscoveryRun" TValue="Guid" Property="@(t => t.Id)" Header="">
                <CellTemplate Context="run">
                    <a class="text-blue-600 underline underline-offset-2" href="/runs/@run.Id">View</a>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
        <EmptyTemplate>
            <p class="border-1 border-slate-700 bg-white p-8 text-center text-lg">No Data Available</p>
        </EmptyTemplate>
    </BbDataTable>
   </div>
    
</div>

@code {
    private string rootUrl = "";
    private int maxDepth = 10;
    private int maxPages = 2000;
    private bool scanAccessibility = true;
    private bool renderJavaScript = true;
    private int javaScriptWaitSeconds = 2;
    private bool starting;
    private string? error;
    private List<DiscoveryRun> runs = [];
    private Dictionary<Guid, SiteQualitySummary> qualitySummaries = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var storedRuns = await db.DiscoveryRuns.AsNoTracking().ToListAsync();
        // SQLite cannot order DateTimeOffset values; sort before applying the display limit.
        runs = storedRuns.OrderByDescending(x => x.CreatedAt).Take(50).ToList();
        var ids = runs.Select(x => x.Id).ToList();
        var quality = await db.PageQualityResults.AsNoTracking().Where(x => ids.Contains(x.DiscoveryRunId)).ToListAsync();
        qualitySummaries = quality.GroupBy(x => x.DiscoveryRunId).ToDictionary(x => x.Key, x => new SiteQualitySummary(x));
    }

    private async Task StartAsync()
    {
        starting = true;
        error = null;
        try
        {
            if (!Uri.TryCreate(rootUrl, UriKind.Absolute, out var uri) || uri.Scheme is not ("http" or "https"))
                throw new InvalidOperationException("Enter a valid absolute HTTP or HTTPS URL.");
            if (maxPages is < 1 or > 100000 || maxDepth is < 0 or > 20)
                throw new InvalidOperationException("Crawl limits are outside the permitted range.");
            if (renderJavaScript && javaScriptWaitSeconds is < 0 or > 60)
                throw new InvalidOperationException("JavaScript wait must be between 0 and 60 seconds.");
            await using var db = await DbFactory.CreateDbContextAsync();
            var run = new DiscoveryRun
            {
                RootUrl = uri.AbsoluteUri, MaxDepth = maxDepth, MaxPages = maxPages,
                ScanAccessibility = scanAccessibility, RenderJavaScript = renderJavaScript,
                JavaScriptWaitSeconds = renderJavaScript ? javaScriptWaitSeconds : 2
            };
            db.DiscoveryRuns.Add(run);
            await db.SaveChangesAsync();
            await Queue.EnqueueAsync(run.Id);
            Navigation.NavigateTo($"/runs/{run.Id}");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            starting = false;
        }
    }

}