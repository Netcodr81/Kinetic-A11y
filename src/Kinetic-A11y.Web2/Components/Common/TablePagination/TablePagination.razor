

@namespace Kinetic_A11y.Web2.Components.Common.TablePagination

<nav class="table-pagination" aria-label="@($"{TableName} pagination")">
    <label>
        Rows per page
        <select @bind:get="PageSize" @bind:set="(int value) => PageSizeChanged.InvokeAsync(value)">
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </label>
    <span role="status">Showing @FirstRow-@LastRow of @TotalCount | Page @Page of @PageCount</span>
    <button type="button" disabled="@(Page <= 1)" @onclick="() => PageChanged.InvokeAsync(1)">First</button>
    <button type="button" disabled="@(Page <= 1)" @onclick="() => PageChanged.InvokeAsync(Page - 1)">Previous</button>
    <button type="button" disabled="@(Page >= PageCount)" @onclick="() => PageChanged.InvokeAsync(Page + 1)">Next</button>
    <button type="button" disabled="@(Page >= PageCount)" @onclick="() => PageChanged.InvokeAsync(PageCount)">Last</button>
</nav>

@code {
    [Parameter, EditorRequired] public string TableName { get; set; } = "";
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public int PageSize { get; set; } = 25;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    private int PageCount => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize));
    private int FirstRow => TotalCount == 0 ? 0 : (Page - 1) * PageSize + 1;
    private int LastRow => Math.Min(Page * PageSize, TotalCount);
}
