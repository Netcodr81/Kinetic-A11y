<button type="@SelectedButtonType"
        @attributes="AdditionalAttributes"
        class="btn @CssClass"
        disabled="@(IsBusy || IsDisabled)"
        aria-busy="@IsBusy"
        @onclick="OnClick">
    @if (IsBusy)
    {
        if (BusyContent is not null)
        {
            @BusyContent
        }
        else if (!string.IsNullOrEmpty(BusyText))
        {
            <span>@BusyText</span>
        }
        else
        {
            <span>@Text</span>
        }
    }
    else if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <span>@Text</span>
    }
</button>

@code {
    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    [EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string? BusyText { get; set; }

    [Parameter]
    public RenderFragment? BusyContent { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public ButtonType ButtonType { get; set; } = ButtonType.Button;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string SelectedButtonType => ButtonType.ToString().ToLowerInvariant();
}