<script type="module" src="@Assets["Components/Layout/SkipToContent.razor.js"]"></script>

<a class="skip-link" href="#@TargetId">@LinkText</a>

@code {
    [Parameter]
    [EditorRequired]
    public required string TargetId { get; set; }

    [Parameter]
    public string LinkText { get; set; } = "Skip to main content";
}