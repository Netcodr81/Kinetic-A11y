            </path>
            <path class="cio-footer__svg-stroke"
                  d="M0 39.1C245.9 12.3 457.8 6 624.7 7.2c196 1.4 325.8 2.4 501.8 26.2 1.3.2 2.7.4 4 .5 100.2 13.7 205.9 33.5 374.4 44.7l3.2.2c93.5 6.1 170.7 7.3 221.9 7.2M790.9 57.7c111.4-8.7 220.4-18.2 335.6-24.2 1.2 0 2.5-.1 3.7-.2 109.9-5.6 196.6-6 248.8-5.5h1.6s22.9.2 45.1.6c16.9.3 138.2 6.4 304.4 18.6M0 58.2c21.3 2.9 52.5 6.9 90.3 10.4 3.2.3 6.5.6 9.7.9 88.8 7.7 158.1 7 200.7 7.6 182.6 2.6 338.7-7.6 490.3-19.4">
            </path>
            <path class="cio-footer__svg-stroke cio-footer__svg-stroke--alt"
                  d="M0 80c34-3.9 67.4-7.4 100-10.5 290.7-27.6 523.8-22.8 690.9-11.8 145.2 9.6 306.9 28.5 556.7 25.6 56.1-.7 108.8-2.3 157.3-4.6 91-4.2 167.4-10.5 225.1-16">
            </path>
        </svg>
    </div>

    <section class="cio-footer__links" aria-label="Footer links">
        <div class="shell-container">
            <ul class="cio-footer__links-list">
                <li><a class="cio-footer__link-item" target="_blank" href="https://www.nebraska.gov/">Nebraska.gov</a><img class="cio-footer__link-item-icon" alt="Nebraska.gov, link, open in new tab" src="/icons/open-in-new.svg"/></li>
                <li><a class="cio-footer__link-item" target="_blank" href="https://governor.nebraska.gov/">Governor</a><img class="cio-footer__link-item-icon" alt="Governor.nebraska.gov, link, open in new tab" src="/icons/open-in-new.svg"/></li>
                <li><a class="cio-footer__link-item" target="_blank" href="https://www.nebraska.gov/policies/">Policies</a><img class="cio-footer__link-item-icon" alt="Nebraska.gov/policies, link, open in new tab" src="/icons/open-in-new.svg"/></li>
            </ul>
        </div>
    </section>

    <section class="cio-footer__social" aria-label="State branding">
        <div class="shell-container cio-footer__social-inner">
            
            <nav class="cio-footer__social-icons" aria-label="Social links">
                <a href="/" class="cio-footer__icon-link" aria-label="Facebook">
                    <span class="cio-footer__icon-wrap">
                        <img src="/icons/facebook.svg" alt="State of Nebraska on Facebook" class="cio-footer__icon-img"/>
                    </span>
                </a>
                <a href="/" class="cio-footer__icon-link" aria-label="X">
                    <span class="cio-footer__icon-wrap">
                        <img src="/icons/x.svg" alt="State of Nebraska on X" class="cio-footer__icon-img"/>
                    </span>
                </a>
                <a href="/" class="cio-footer__icon-link" aria-label="LinkedIn">
                    <span class="cio-footer__icon-wrap">
                        <img src="/icons/linkedin.svg" alt="State of Nebraska on LinkedIn" class="cio-footer__icon-img"/>
                    </span>
                </a>
                <a href="/" class="cio-footer__icon-link" aria-label="YouTube">
                    <span class="cio-footer__icon-wrap">
                        <img src="/icons/youtube.svg" alt="State of Nebraska on YouTube" class="cio-footer__icon-img"/>
                    </span>
                </a>
            </nav>
        </div>
    </section>

    <section class="cio-footer__copyright">
        <div class="shell-container">
            <div class="cio-footer__copyright-content">
                <span>&copy; @DateTime.UtcNow.Year State of Nebraska</span>
            </div>
        </div>
    </section>
</footer>
