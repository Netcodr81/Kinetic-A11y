@page "/runs/{RunId:guid}"
@rendermode InteractiveServer
@using Kinetic
@implements IAsyncDisposable
@inject IDbContextFactory<DiscoveryDbContext> DbFactory
@inject DiscoveryRunControl RunControl
@inject NavigationManager Navigation

<PageTitle>Discovery run</PageTitle>
<a href="/">← All runs</a>
@if (run is null) { <p>@(loaded ? "This discovery run no longer exists." : "Loading run...")</p> }
else
{
    <h1>Discovery results</h1>
    <p class="muted">@run.RootUrl</p>
    <p class="muted">Scan mode: @(run.RenderJavaScript ? $"JavaScript rendered, {run.JavaScriptWaitSeconds}s wait after load" : "Server HTML (fast)")</p>
    <div class="stats">
        <div class="stat"><strong>@run.PagesCrawled</strong><span>Pages crawled</span></div>
        <div class="stat"><strong>@run.PdfsDiscovered</strong><span>PDFs discovered</span></div>
        <div class="stat"><strong>@run.PdfsValidated</strong><span>Validated</span></div>
        <div class="stat"><strong>@run.FailedRequests</strong><span>Failed requests</span></div>
    </div>
    <p>Status: <strong>@run.Status</strong> · Started: @run.StartedAt?.ToLocalTime().ToString("g")</p>
    @if (run.Status == DiscoveryRunStatus.Running && !string.IsNullOrWhiteSpace(run.CurrentActivity))
    {
        <p role="status">Current activity: @run.CurrentActivity</p>
        <p class="muted">Link checks and PDF validation run separately from page scans. Discovered PDFs appear as Pending until validation finishes.</p>
    }
    @if (run.Status is DiscoveryRunStatus.Queued or DiscoveryRunStatus.Running)
    {
        <button @onclick="CancelAsync" disabled="@changingRun">@(changingRun && !deleting ? "Cancelling..." : "Cancel scan")</button>
    }
    else
    {
        <button @onclick="RestartAsync" disabled="@changingRun">@(changingRun && !deleting ? "Starting..." : "Start again")</button>
        <p class="muted">Starting again permanently deletes this run and its results and creates a fresh run with the same settings.</p>
    }
    @if (confirmDelete)
    {
        <div class="panel">
            <p id="delete-warning">Permanently delete this scan and all its PDF and accessibility results? Any active scan will be stopped. This cannot be undone.</p>
            <button @onclick="DeleteAsync" disabled="@changingRun" aria-describedby="delete-warning">@(deleting ? "Deleting..." : "Confirm delete")</button>
            <button @onclick="() => confirmDelete = false" disabled="@changingRun">Keep scan</button>
        </div>
    }
    else
    {
        <button @onclick="() => confirmDelete = true" disabled="@changingRun">Delete scan</button>
    }
    @if (!string.IsNullOrWhiteSpace(actionError)) { <p class="error" role="alert">@actionError</p> }
    @if (!string.IsNullOrWhiteSpace(run.Error)) { <p class="error">@run.Error</p> }
    <div class="toolbar">
        <h2>Discovered PDFs</h2>
        <a href="/runs/@RunId/export">Export CSV</a>
    </div>
    <table>
        <thead><tr><th>File</th><th>Status</th><th>Size</th><th>Source page</th><th>PDF URL</th></tr></thead>
        <tbody>
        @foreach (var pdf in documents.Skip((pdfPage - 1) * pdfPageSize).Take(pdfPageSize))
        {
            <tr @key="pdf.Id">
                <td>@pdf.FileName</td><td>@pdf.Status</td>
                <td>@(pdf.FileSizeBytes.HasValue ? $"{pdf.FileSizeBytes.Value:N0} bytes" : "—")</td>
                <td><a href="@pdf.SourcePageUrl" target="_blank" rel="noopener noreferrer">Source</a></td>
                <td><a href="@pdf.Url" target="_blank" rel="noopener noreferrer">Open PDF</a></td>
            </tr>
        }
        </tbody>
    </table>
    <TablePagination TableName="Discovered PDFs" TotalCount="documents.Count"
                     @bind-Page="pdfPage" @bind-PageSize="pdfPageSize" @bind-PageSize:after="() => pdfPage = 1" />

    <div class="toolbar">
        <h2>Site and page quality scores</h2>
        <a href="/runs/@RunId/quality/export">Export quality CSV</a>
    </div>
    @if (qualityResults.Count == 0)
    {
        <p class="muted">No page quality results yet. Check the current activity and any errors above. Accessibility and SEO appear before link checks finish; overall scores remain N/A until the required category results are available.</p>
    }
    else
    {
        <div class="stats">
            <div class="stat"><strong>@FormatScore(qualitySummary.Overall)</strong><span>Overall site score</span></div>
            <div class="stat"><strong>@FormatScore(qualitySummary.Accessibility)</strong><span>Accessibility</span></div>
            <div class="stat"><strong>@FormatScore(qualitySummary.BrokenLinks)</strong><span>Broken links</span></div>
            <div class="stat"><strong>@FormatScore(qualitySummary.Seo)</strong><span>SEO</span></div>
            <div class="stat"><strong>@FormatScore(qualitySummary.BestPractices)</strong><span>Best Practices (excluded from overall)</span></div>
        </div>
        <p class="muted">DubBot-style scores: 100 minus 5 per distinct issue type, minimum 0. Category scores average successfully checked pages; overall averages enabled categories, excluding Best Practices. Fully scored pages: @qualitySummary.FullyScoredPages / @qualitySummary.Pages. Failed or disabled checks show N/A, not 100. Scores are provisional while scanning or when coverage is incomplete.</p>
        <table>
            <thead><tr><th>Page</th><th>Overall</th><th>Accessibility</th><th>Broken links</th><th>SEO</th><th>Best Practices</th><th>Issues</th></tr></thead>
            <tbody>
            @foreach (var quality in qualityResults.Skip((qualityPage - 1) * qualityPageSize).Take(qualityPageSize))
            {
                <tr @key="quality.Id">
                    <td><a href="@quality.Url" target="_blank" rel="noopener noreferrer">@quality.Url</a></td>
                    <td>@FormatScore(quality.OverallScore)</td>
                    <td>@FormatScore(quality.AccessibilityScore)</td>
                    <td>@FormatScore(quality.BrokenLinksScore)</td>
                    <td>@FormatScore(quality.SeoScore)</td>
                    <td>@FormatScore(quality.BestPracticesScore)</td>
                    <td>
                        @if (quality.LinkCheckError is not null) { <p class="error">@quality.LinkCheckError</p> }
                        <details>
                            <summary>View issue types</summary>
                            <ul>
                            @foreach (var issue in qualityIssues[quality.Id])
                            {
                                <li><strong>@issue.Category:</strong>
                                    @if (issue.WcagLevel is not null) { <span>WCAG @issue.WcagLevel · </span> }
                                    @issue.Message <code>@issue.RuleId</code>
                                    @if (issue.Target is not null) { <div><code>@issue.Target</code></div> }
                                </li>
                            }
                            </ul>
                        </details>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        <TablePagination TableName="Site and page quality scores" TotalCount="qualityResults.Count"
                         @bind-Page="qualityPage" @bind-PageSize="qualityPageSize" @bind-PageSize:after="() => qualityPage = 1" />
    }

    @if (run.ScanAccessibility)
    {
        var avg = run.AverageAccessibilityScore is { } a ? (int?)Math.Round(a) : null;
        <div class="toolbar">
            <h2>Page accessibility</h2>
            <a href="/runs/@RunId/accessibility/export">Export accessibility CSV</a>
        </div>
        <div class="stats">
            <div class="stat"><strong><span class="score score-@AccessibilityScoring.Band(avg)">@(avg?.ToString() ?? "—")</span></strong><span>@(qualityResults.Count == 0 ? "Legacy weighted accessibility score" : "Average accessibility score")</span></div>
            <div class="stat"><strong>@run.PagesAccessibilityScanned</strong><span>Pages scanned</span></div>
            <div class="stat"><strong>@run.AccessibilityScanFailures</strong><span>Scan failures</span></div>
            <div class="stat"><strong>@accessibilityResults.Sum(x => x.CriticalCount + x.SeriousCount)</strong><span>Critical + serious rule failures</span></div>
        </div>
        <p class="muted">Automated axe-core checks (WCAG A/AA/AAA) detect only a subset of accessibility issues. Repeated elements failing the same rule count as one issue type. Impact affects display order, not scoring. The score is a heuristic, not a compliance determination.</p>
        @if (accessibilityResults.Count == 0) { <p class="muted">No pages scanned yet.</p> }
        else
        {
            <table>
                <thead><tr><th>Score</th><th>Page</th><th>Critical</th><th>Serious</th><th>Moderate</th><th>Minor</th><th>Violations</th></tr></thead>
                <tbody>
                @foreach (var pageResult in accessibilityResults.Skip((accessibilityPage - 1) * accessibilityPageSize).Take(accessibilityPageSize))
                {
                    <tr @key="pageResult.Id">
                        <td><span class="score score-@AccessibilityScoring.Band(pageResult.Score)">@(pageResult.Score?.ToString() ?? "—")</span>
                            @if (!qualityUrls.Contains(pageResult.Url)) { <span class="muted">Legacy</span> }
                        </td>
                        <td><a href="@pageResult.Url" target="_blank" rel="noopener noreferrer">@pageResult.Url</a></td>
                        <td>@pageResult.CriticalCount</td><td>@pageResult.SeriousCount</td><td>@pageResult.ModerateCount</td><td>@pageResult.MinorCount</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(pageResult.Error)) { <span class="error">@pageResult.Error</span> }
                            else if (pageResult.Violations.Count == 0) { <span class="muted">None</span> }
                            else
                            {
                                <details>
                                    <summary>@pageResult.Violations.Count rule(s)</summary>
                                    <ul>
                                    @foreach (var v in pageResult.Violations)
                                    {
                                        <li>
                                            <span class="impact impact-@v.Impact">@v.Impact</span>
                                            @if (v.WcagLevel is not null) { <strong>WCAG @v.WcagLevel</strong> }
                                            <a href="@v.HelpUrl" target="_blank" rel="noopener noreferrer">@v.RuleId</a>
                                            — @v.Help (@v.NodeCount element@(v.NodeCount == 1 ? "" : "s"))
                                            @if (!string.IsNullOrWhiteSpace(v.PreviewPath))
                                            {
                                                <div><a href="/runs/@RunId/accessibility/violations/@v.Id/preview" target="_blank" rel="noopener noreferrer">View highlighted preview</a></div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(v.SampleTarget)) { <div><code>@v.SampleTarget</code></div> }
                                        </li>
                                    }
                                    </ul>
                                </details>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            <TablePagination TableName="Page accessibility" TotalCount="accessibilityResults.Count"
                             @bind-Page="accessibilityPage" @bind-PageSize="accessibilityPageSize" @bind-PageSize:after="() => accessibilityPage = 1" />
        }
    }
}
@code {
    [Parameter] public Guid RunId { get; set; }
    private DiscoveryRun? run;
    private List<DiscoveredPdf> documents = [];
    private List<PageAccessibilityResult> accessibilityResults = [];
    private List<PageQualityResult> qualityResults = [];
    private SiteQualitySummary qualitySummary = new([]);
    private Dictionary<Guid, List<QualityIssue>> qualityIssues = [];
    private HashSet<string> qualityUrls = [];
    private int pdfPage = 1;
    private int pdfPageSize = 25;
    private int qualityPage = 1;
    private int qualityPageSize = 25;
    private int accessibilityPage = 1;
    private int accessibilityPageSize = 25;
    private static string FormatScore(double? score) => score?.ToString("0.#") ?? "N/A";
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;
    private bool changingRun;
    private bool deleting;
    private bool confirmDelete;
    private bool loaded;
    private string? actionError;

    private async Task DeleteAsync()
    {
        changingRun = true;
        deleting = true;
        actionError = null;
        try
        {
            await RunControl.DeleteAsync(RunId);
            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex) { actionError = ex.Message; }
        finally { changingRun = false; deleting = false; }
    }

    private async Task CancelAsync()
    {
        changingRun = true;
        actionError = null;
        try
        {
            await RunControl.CancelAsync(RunId);
            await RefreshAsync();
        }
        catch (Exception ex) { actionError = ex.Message; }
        finally { changingRun = false; }
    }

    private async Task RestartAsync()
    {
        changingRun = true;
        actionError = null;
        try
        {
            var replacementId = await RunControl.RestartAsync(RunId);
            Navigation.NavigateTo($"/runs/{replacementId}", forceLoad: true);
        }
        catch (Exception ex) { actionError = ex.Message; }
        finally { changingRun = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        cts = new CancellationTokenSource();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        await RefreshAsync();
        _ = PollAsync(cts.Token);
    }
    private async Task PollAsync(CancellationToken ct)
    {
        try
        {
            while (timer is not null && await timer.WaitForNextTickAsync(ct))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
                if (run is null || run.Status is DiscoveryRunStatus.Completed or DiscoveryRunStatus.Failed or DiscoveryRunStatus.Cancelled) break;
            }
        }
        catch (OperationCanceledException) { }
    }
    private async Task RefreshAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        run = await db.DiscoveryRuns.AsNoTracking().SingleOrDefaultAsync(x => x.Id == RunId);
        loaded = true;
        var quality = await db.PageQualityResults.AsNoTracking().Where(x => x.DiscoveryRunId == RunId).ToListAsync();
        qualitySummary = new(quality);
        qualityUrls = quality.Select(x => x.Url).ToHashSet(StringComparer.Ordinal);
        qualityResults = quality.OrderBy(x => x.OverallScore ?? double.MaxValue).ThenBy(x => x.Url).ThenBy(x => x.Id).ToList();
        qualityIssues = qualityResults.ToDictionary(x => x.Id,
            x => System.Text.Json.JsonSerializer.Deserialize<List<QualityIssue>>(x.IssuesJson)
                ?? throw new InvalidOperationException("Invalid stored quality issues."));
        var storedDocuments = await db.DiscoveredPdfs.AsNoTracking()
            .Where(x => x.DiscoveryRunId == RunId).ToListAsync();
        // SQLite cannot sort DateTimeOffset values, so order the filtered results in memory.
        documents = storedDocuments.OrderByDescending(x => x.FirstDiscoveredAt).ThenBy(x => x.Id).ToList();
        if (run?.ScanAccessibility == true)
        {
            var storedResults = await db.PageAccessibilityResults.AsNoTracking().Include(x => x.Violations)
                .Where(x => x.DiscoveryRunId == RunId).ToListAsync();
            accessibilityResults = storedResults
                .OrderBy(x => x.Score ?? int.MaxValue).ThenBy(x => x.Url).ThenBy(x => x.Id).ToList();
            foreach (var result in accessibilityResults)
                result.Violations = result.Violations
                    .OrderByDescending(v => AccessibilityScoring.ImpactWeight(v.Impact)).ThenByDescending(v => v.NodeCount).ToList();
        }
        pdfPage = Math.Clamp(pdfPage, 1, Math.Max(1, (int)Math.Ceiling(documents.Count / (double)pdfPageSize)));
        qualityPage = Math.Clamp(qualityPage, 1, Math.Max(1, (int)Math.Ceiling(qualityResults.Count / (double)qualityPageSize)));
        accessibilityPage = Math.Clamp(accessibilityPage, 1, Math.Max(1, (int)Math.Ceiling(accessibilityResults.Count / (double)accessibilityPageSize)));
    }
    public ValueTask DisposeAsync()
    {
        cts?.Cancel(); cts?.Dispose(); timer?.Dispose();
        return ValueTask.CompletedTask;
    }
}
