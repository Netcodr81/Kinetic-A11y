@using System.Text
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="@ContainerCssClass" style="@ContainerStyle">
    <a href="@AnchorHref"
       class="@ButtonCssClass"
       style="@ButtonStyle"
       aria-label="@AriaLabel"
       @onclick="HandleClickAsync"
       @onclick:preventDefault="true">
        @if (IconContent is not null && IconLocation == ReturnToTopButtonIconLocation.Prepend)
        {
            <span class="return-to-anchor-btn__icon" aria-hidden="true">
                @IconContent
            </span>
        }

        @if (!string.IsNullOrWhiteSpace(ButtonText))
        {
            <span class="return-to-anchor-btn__text">@ButtonText</span>
        }

        @if (IconContent is not null && IconLocation == ReturnToTopButtonIconLocation.Append)
        {
            <span class="return-to-anchor-btn__icon" aria-hidden="true">
                @IconContent
            </span>
        }
    </a>
</div>

@code {
    private const string DefaultDividerColor = "#64748b";
    private const string JavaScriptModulePath = "./Components/Common/ReturnToTopButton/ReturnToTopButton.razor.js";

    private IJSObjectReference? module;

    [Parameter]
    public string ButtonText { get; set; } = string.Empty;

    [Parameter]
    public string TargetAnchorId { get; set; } = "top";

    [Parameter]
    public ReturnToTopButtonVariant ButtonVariant { get; set; } = ReturnToTopButtonVariant.Primary;

    [Parameter]
    public ReturnToTopButtonIconLocation IconLocation { get; set; } = ReturnToTopButtonIconLocation.Prepend;

    [Parameter]
    public RenderFragment? IconContent { get; set; }

    [Parameter]
    public bool ShowDivider { get; set; }

    [Parameter]
    public string? DividerColor { get; set; }

    [Parameter]
    public string? MinWidth { get; set; }

    [Parameter]
    public string? MaxWidth { get; set; }

    [Parameter]
    public string? Width { get; set; }

    [Parameter]
    public string? ContainerClass { get; set; }

    private string ContainerCssClass =>
        string.IsNullOrWhiteSpace(ContainerClass)
            ? "return-to-anchor-btn__container"
            : $"return-to-anchor-btn__container {ContainerClass}";

    private string ButtonCssClass =>
        $"return-to-anchor-btn__button return-to-anchor-btn__{ButtonVariant.ToString().ToLowerInvariant()} return-to-anchor-btn__link";

    private string AnchorHref => $"#{NormalizeAnchorId(TargetAnchorId)}";

    private string? AriaLabel => string.IsNullOrWhiteSpace(ButtonText)
        ? $"Return to {NormalizeAnchorId(TargetAnchorId)}"
        : null;

    private string? ContainerStyle => ShowDivider
        ? $"border-top:1px solid {GetDividerColor()};padding-top:1.25rem;"
        : null;

    private string ButtonStyle => BuildButtonStyle();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", JavaScriptModulePath);
    }

    private async Task HandleClickAsync()
    {
        if (module is null)
        {
            return;
        }

        await module.InvokeVoidAsync("scrollToAnchor", NormalizeAnchorId(TargetAnchorId));
    }

    private string BuildButtonStyle()
    {
        var style = new StringBuilder();

        AppendStyle(style, "min-width", MinWidth);
        AppendStyle(style, "max-width", MaxWidth);
        AppendStyle(style, "width", Width);

        return style.Length == 0 ? string.Empty : style.ToString();
    }

    private static void AppendStyle(StringBuilder builder, string propertyName, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        builder.Append(propertyName);
        builder.Append(':');
        builder.Append(value.Trim());
        builder.Append(';');
    }

    private string GetDividerColor()
    {
        return string.IsNullOrWhiteSpace(DividerColor)
            ? DefaultDividerColor
            : DividerColor.Trim();
    }

    private static string NormalizeAnchorId(string? anchorId)
    {
        var value = string.IsNullOrWhiteSpace(anchorId)
            ? "top"
            : anchorId.Trim();

        return value.StartsWith('#') ? value[1..] : value;
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null)
        {
            return;
        }

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            module = null;
        }
    }

  

   
}
