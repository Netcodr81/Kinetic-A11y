@using BlazorBlueprint.Icons.Lucide.Components
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService

@if (IsMobile && VisibleItems.Count > 0)
{
    <li class="wrapper-item menu-dropdown-mobile">
        <details name="header-dropdowns">
            <summary class="mobile-summary">
                <span class="summary-text">@Title</span>
                <span class="summary-icon menu-dropdown-mobile-closed" aria-hidden="true">
                    <LucideIcon Name="plus" />
                </span>
                <span class="summary-icon menu-dropdown-mobile-open" aria-hidden="true">
                    <LucideIcon Name="minus" />
                </span>
            </summary>
            <ul>
                @foreach (var item in VisibleItems)
                {
                    @if (string.IsNullOrWhiteSpace(item.RequiredPolicy))
                    {
                        <li @key="item.Href" class="mobile-menu-list-item">
                            <a href="@item.Href" target="@item.Target">@item.Text</a>
                        </li>
                    }
                    else
                    {
                        <AuthorizeView Policy="@item.RequiredPolicy">
                            <Authorized Context="itemAuthState">
                                <li @key="item.Href" class="mobile-menu-list-item">
                                    <a href="@item.Href" target="@item.Target">@item.Text</a>
                                </li>
                            </Authorized>
                        </AuthorizeView>
                    }
                }
            </ul>
        </details>
    </li>
}
else if(VisibleItems.Count > 0)
{
    <li class="cio__nav-dropdown menu-dropdown-root">
        <details name="header-dropdowns">
            <summary class="dropdown-toggle cio__dropdown">
                <span>@Title</span>
                <span class="menu-dropdown-chevron" aria-hidden="true">
                    <LucideIcon Name="chevron-down" Size="18" />
                </span>
            </summary>
            <div class="cio__dropdown-list menu-dropdown-panel">
                <ul class="menu-dropdown-links">
                    @foreach (var item in VisibleItems)
                    {
                        @if (string.IsNullOrWhiteSpace(item.RequiredPolicy))
                        {
                            <li @key="item.Href">
                                <a href="@item.Href" target="@item.Target">@item.Text</a>
                            </li>
                        }
                        else
                        {
                            <AuthorizeView Policy="@item.RequiredPolicy">
                                <Authorized Context="itemAuthState">
                                    <li @key="item.Href">
                                        <a href="@item.Href" target="@item.Target">@item.Text</a>
                                    </li>
                                </Authorized>
                            </AuthorizeView>
                        }
                    }
                </ul>
            </div>
        </details>
    </li>
}

@code {
    [Parameter] public bool IsMobile { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyList<MenuDropdownItem> Items { get; set; } = [];

    private IReadOnlyList<MenuDropdownItem> VisibleItems { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        VisibleItems = await GetVisibleItemsAsync();
    }

    private async Task<IReadOnlyList<MenuDropdownItem>> GetVisibleItemsAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        var visibleItems = new List<MenuDropdownItem>(Items.Count);

        foreach (var item in Items)
        {
            if (await CanViewItemAsync(user, item))
            {
                visibleItems.Add(item);
            }
        }

        return visibleItems;
    }

    private async Task<bool> CanViewItemAsync(System.Security.Claims.ClaimsPrincipal user, MenuDropdownItem item)
    {
        if (string.IsNullOrWhiteSpace(item.RequiredPolicy))
        {
            return true;
        }

        var result = await AuthorizationService.AuthorizeAsync(user, policyName: item.RequiredPolicy);
        return result.Succeeded;
    }
}