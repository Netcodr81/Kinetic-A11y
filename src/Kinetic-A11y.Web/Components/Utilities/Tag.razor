<span class="@GetClasses() default" @attributes="AdditionalAttributes" style="background-color:@BackgroundColor;color:@TextColor">@Text</span>

@code
{
    [Parameter]
    [EditorRequired]
    public string Text { get; set; }

    [Parameter]
    public string BackgroundColor { get; set; } = "#00607f"; // Default color

    [Parameter]
    public string TextColor { get; set; } = "#ffffff"; // Default text color

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private string GetClasses()
    {
        if (Class is null)
        {
            return "tag";
        }

        return Class;
    }
}
