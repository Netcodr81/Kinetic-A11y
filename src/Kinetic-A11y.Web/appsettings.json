{
  "ConnectionStrings": { "Discovery": "Data Source=pdf-discovery.db" },
  "Crawler": {
    "MaxDepth": 5,
    "MaxPages": 2000,
    "MaxConcurrentRequests": 3,
    "DelayMilliseconds": 500,
    "RequestTimeoutSeconds": 25,
    "AllowedHosts": [],
    "CheckSitemaps": true
  },
  "Accessibility": {
    "Enabled": true,
    "Tags": [ "wcag2a", "wcag2aa", "wcag21a", "wcag21aa", "wcag22a", "wcag22aa" ],
    "PageTimeoutSeconds": 30,
    "MaxViolationsStoredPerPage": 100,
    "CaptureIssuePreviews": true,
    "IssuePreviewDirectory": "App_Data/issue-previews",
    "MaxIssuePreviewsPerPage": 10,
    "AutoInstallBrowsers": true,
    "Headless": true
  }
}
